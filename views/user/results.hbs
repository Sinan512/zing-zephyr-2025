<link rel="stylesheet" href="/stylesheets/user-results.css">

<div class="user-results-container">
  <div class="container py-4">
    <div class="row justify-content-center">
      <div class="col-12">
        <h2 class="page-title text-center mb-4">
          <i class="bi bi-trophy-fill"></i> Published Results
        </h2>

        <!-- 🔍 Single Universal Search Bar -->
        <div class="search-container mb-5">
          <div class="search-wrapper">
            <i class="bi bi-search search-icon"></i>
            <input 
              type="text" 
              id="globalSearchInput" 
              class="program-search-input" 
              placeholder="🔍 Search by Program Name or Member Name..." 
              autocomplete="off"
            />
            <button class="clear-search-btn" id="clearGlobalSearchBtn" style="display: none;" onclick="clearGlobalSearch()">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
          <div class="search-info" id="searchInfo">
            <span id="resultCount">{{publishedResults.length}}</span> program result(s) found
          </div>
        </div>

        <!-- Results Grid -->
        {{#if publishedResults}}
          <div class="row g-4" id="resultsGrid">
            {{#each publishedResults}}
            <div class="col-12 col-md-6 col-lg-4 result-item" data-program="{{this.programName}}">
              <div class="result-card">
                <div class="publish-order-badge">#{{this.publishOrder}}</div>
                <div class="card-header">
                  <h3 class="program-title">{{this.programName}}</h3>
                  <span class="zone-badge">{{this.zone}}</span>
                </div>
                <div class="card-body">
                  {{#if this.top3}}
                    {{#if (length this.top3)}}
                    <div class="winners-container">
                      {{#each this.top3}}
                      <div class="winner-card {{#if (eq this.position 1)}}winner-first{{else if (eq this.position 2)}}winner-second{{else if (eq this.position 3)}}winner-third{{/if}}">
                        <div class="prize-icon">
                          {{#if (eq this.position 1)}}🥇{{else if (eq this.position 2)}}🥈{{else if (eq this.position 3)}}🥉{{/if}}
                        </div>
                        <div class="winner-info">
                          <span class="prize-label">
                            {{#if (eq this.position 1)}}First Prize{{else if (eq this.position 2)}}Second Prize{{else if (eq this.position 3)}}Third Prize{{/if}}
                          </span>
                          <h4 class="winner-name">{{this.participant}}</h4>
                          <span class="winner-team">{{this.team}}</span>
                        </div>
                      </div>
                      {{/each}}
                    </div>
                    {{else}}
                    <div class="no-winners">
                      <p>No participants yet</p>
                    </div>
                    {{/if}}
                  {{else}}
                    <div class="no-winners">
                      <p>No participants yet</p>
                    </div>
                  {{/if}}
                </div>
              </div>
            </div>
            {{/each}}
          </div>
        {{else}}
          <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <p>No results published yet. Check back soon!</p>
          </div>
        {{/if}}
      </div>
    </div>
  </div>
</div>

<script>
  const publishedResults = {{{json publishedResults}}};
  let searchTimeout;

  $('#globalSearchInput').on('keyup input', function () {
    const searchValue = $(this).val().trim().toLowerCase();

    // Show/hide clear button
    if (searchValue.length > 0) {
      $('#clearGlobalSearchBtn').fadeIn(200);
    } else {
      $('#clearGlobalSearchBtn').fadeOut(200);
    }

    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(function () {
      $('.result-item').each(function () {
        const programName = $(this).data('program').toLowerCase();
        const program = publishedResults.find(p => p.programName.toLowerCase() === programName);
        let matches = false;

        // Match program name
        if (programName.includes(searchValue)) matches = true;

        // Match any participant name
        if (program && program.top3) {
          for (const winner of program.top3) {
            if (winner.participant.toLowerCase().includes(searchValue)) {
              matches = true;
              break;
            }
          }
        }

        // Show or hide
        if (matches || searchValue.length === 0) {
          $(this).fadeIn(300);
        } else {
          $(this).fadeOut(300);
        }
      });

      // Update count
      const visibleCount = $('.result-item:visible').length;
      const totalCount = $('.result-item').length;
      if (searchValue.length > 0) {
        $('#searchInfo').html(`<span id="resultCount">${visibleCount}</span> of <span>${totalCount}</span> program result(s) found`);
      } else {
        $('#searchInfo').html(`<span id="resultCount">${totalCount}</span> program result(s) found`);
      }
    }, 300);
  });

  function clearGlobalSearch() {
    $('#globalSearchInput').val('');
    $('#clearGlobalSearchBtn').fadeOut(200);
    $('.result-item').fadeIn(300);
    const totalCount = $('.result-item').length;
    $('#searchInfo').html(`<span id="resultCount">${totalCount}</span> program result(s) found`);
  }
</script>
