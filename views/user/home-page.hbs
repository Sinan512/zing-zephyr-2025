<link rel="stylesheet" href="/stylesheets/user-home.css">

<div class="user-home-container">
  
  <!-- Hero/About Section -->
  <section id="home" class="hero-section">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
          <div class="hero-card">
            <div class="hero-content">
              <h1 class="hero-title" data-aos="fade-down">Welcome to {{fName}}</h1>
              <p class="hero-subtitle" data-aos="fade-up" data-aos-delay="100">
                A magnificent fusion of creativity, passion, and unity
              </p>
              <p class="hero-description" data-aos="fade-up" data-aos-delay="200">
                From music to theatre, painting to poetry, this celebration ignites imagination and nurtures collaboration.
                Every performance reflects our shared belief that when <strong>"I" becomes "We"</strong>, wonders happen.
              </p>
              <div class="hero-buttons" data-aos="fade-up" data-aos-delay="300">
                <a href="#teams" class="btn-hero btn-primary">
                  <i class="bi bi-people"></i> Meet Teams
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Animated Background Elements -->
    <div class="floating-shapes">
      <div class="shape shape-1"></div>
      <div class="shape shape-2"></div>
      <div class="shape shape-3"></div>
    </div>
  </section>

  <!-- Teams Section with Historical Background -->
  <section id="teams" class="teams-section">
    <div class="container">
      <h2 class="section-title" data-aos="fade-down">
        <i class="bi bi-people-fill"></i> Our Legendary Teams
      </h2>
      <div class="row g-4">
        {{#each teams}}
        <div class="col-12 col-md-6 col-lg-3" data-aos="zoom-in" data-aos-delay="{{@index}}00">
          <div class="team-card-historical" data-team="{{this.teamName}}">
            <div class="team-header">
              <div class="team-icon-wrapper">
                <i class="bi bi-flag-fill"></i>
              </div>
              <h3 class="team-name-hist">{{this.teamName}}</h3>
            </div>
            <div class="team-body">
              <div class="historical-info">
                {{#if (eq this.teamName "GHARNATA")}}
                  <p class="history-text">Inspired by Granada — symbolizing passion, art, and spirit. Granada represents the pinnacle of Andalusian culture and artistic excellence.</p>
                {{else if (eq this.teamName "SARAQUSTA")}}
                  <p class="history-text">Rooted in Zaragoza — a blend of strength and culture. Zaragoza embodies resilience and rich cultural heritage.</p>
                {{else if (eq this.teamName "THULYTHULA")}}
                  <p class="history-text">From Seville — representing harmony, beauty, and elegance. Seville is known for its artistic and cultural sophistication.</p>
                {{else if (eq this.teamName "ISHBILIYYA")}}
                  <p class="history-text">Echoing Córdoba — symbol of unity and creativity. Córdoba represents intellectual brilliance and collaborative spirit.</p>
                {{else}}
                  <p class="history-text">A team dedicated to excellence, unity, and creative expression in the spirit of Zing Zephyr.</p>
                {{/if}}
              </div>
            </div>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </section>

</div>

<script>
  // Team card hover effects
  document.querySelectorAll('.team-card-historical').forEach(card => {
    card.addEventListener('mouseenter', function() {
      this.classList.add('hovered');
    });
    card.addEventListener('mouseleave', function() {
      this.classList.remove('hovered');
    });
  });

  // Smooth scrolling for anchor links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const target = document.querySelector(this.getAttribute('href'));
      if (target) {
        target.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    });
  });
</script>
