<link rel="stylesheet" href="/stylesheets/user-home.css">

<div class="user-home-container">
  
  <!-- Hero/About Section -->
  <section id="home" class="hero-section">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
          <div class="hero-card">
            <div class="hero-content">
              <h1 class="hero-title" data-aos="fade-down">Welcome to {{fName}}</h1>
              <p class="hero-subtitle" data-aos="fade-up" data-aos-delay="100">
                A magnificent fusion of creativity, passion, and unity
              </p>
              <p class="hero-description" data-aos="fade-up" data-aos-delay="200">
                From music to theatre, painting to poetry, this celebration ignites imagination and nurtures collaboration.
                Every performance reflects our shared belief that when <strong>"I" becomes "We"</strong>, wonders happen.
              </p>
              <div class="hero-buttons" data-aos="fade-up" data-aos-delay="300">
                <a href="#programs" class="btn-hero btn-primary">
                  <i class="bi bi-calendar-event"></i> Programs
                </a>
                <a href="#teams" class="btn-hero btn-secondary">
                  <i class="bi bi-people"></i> Meet Teams
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Animated Background Elements -->
    <div class="floating-shapes">
      <div class="shape shape-1"></div>
      <div class="shape shape-2"></div>
      <div class="shape shape-3"></div>
    </div>
  </section>

  <!-- About Programs Section -->
  <section id="programs" class="programs-section">
    <div class="container">
      <h2 class="section-title" data-aos="fade-down">
        <i class="bi bi-calendar-event-fill"></i> Our Programs
      </h2>
      
      <div class="empty-state" data-aos="fade-up">
        <i class="bi bi-calendar-check"></i>
        <p>Explore our exciting programs and events!</p>
      </div>
    </div>
  </section>

  <!-- Teams Section -->
  <section id="teams" class="teams-section">
    <div class="container">
      <h2 class="section-title" data-aos="fade-down">
        <i class="bi bi-people-fill"></i> Our Legendary Teams
      </h2>
      <div class="row g-4">
        {{#each teams}}
        <div class="col-12 col-sm-6 col-md-6 col-lg-3" data-aos="zoom-in" data-aos-delay="{{@index}}00">
          <div class="team-card-modern" data-team="{{this.teamName}}">
            <div class="team-glow"></div>
            <div class="team-content">
              <div class="team-icon">
                <i class="bi bi-flag-fill"></i>
              </div>
              <h3 class="team-name">{{this.teamName}}</h3>
              <div class="team-stats">
                <span class="stat">
                  <i class="bi bi-person"></i>
                  <span id="member-count-{{@index}}">-</span>
                </span>
              </div>
            </div>
            <div class="team-overlay">
              <p>Click to explore team members and achievements</p>
            </div>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </section>

</div>

<!-- Program Details Modal -->
<div id="programModal" class="modal-overlay">
  <div class="modal-content">
    <span class="modal-close" onclick="closeProgramModal()">&times;</span>
    <div id="modalBody"></div>
  </div>
</div>

<script>
  // Calculate and display member counts
  document.addEventListener('DOMContentLoaded', function() {
    {{#each teams}}
    (function(index) {
      let count = 0;
      {{#if this.["Pre Zone"]}}
      {{#each this.["Pre Zone"]}}
      count++;
      {{/each}}
      {{/if}}
      {{#if this.["Mid Zone"]}}
      {{#each this.["Mid Zone"]}}
      count++;
      {{/each}}
      {{/if}}
      {{#if this.["High Zone"]}}
      {{#each this.["High Zone"]}}
      count++;
      {{/each}}
      {{/if}}
      const element = document.getElementById('member-count-' + index);
      if (element) element.textContent = count || '0';
    })({{@index}});
    {{/each}}
  });

  function viewProgramDetails(programName, zone) {
    // This would fetch and display full program details
    // For now, show a simple alert
    alert(`Program: ${programName}\nZone: ${zone}\n\nFull details coming soon!`);
  }

  function closeProgramModal() {
    document.getElementById('programModal').style.display = 'none';
  }

  // Smooth scrolling for anchor links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const target = document.querySelector(this.getAttribute('href'));
      if (target) {
        target.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    });
  });

  // Team card hover effects
  document.querySelectorAll('.team-card-modern').forEach(card => {
    card.addEventListener('mouseenter', function() {
      this.classList.add('hovered');
    });
    card.addEventListener('mouseleave', function() {
      this.classList.remove('hovered');
    });
  });
</script>
