<link rel="stylesheet" href="/stylesheets/user-home.css">

<div class="user-home-container">
  
  <!-- Hero/About Section -->
  <section id="home" class="hero-section">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
          <div class="hero-card">
            <div class="hero-content">
              <h1 class="hero-title" data-aos="fade-down">Welcome to {{fName}}</h1>
              <p class="hero-subtitle" data-aos="fade-up" data-aos-delay="100">
                "Bridging faith, talent, and global excellence through leadership."</p>
              <p class="hero-description" data-aos="fade-up" data-aos-delay="200">Zing Zephyr '25 is the premier annual festival of art and culture, organized by <strong> ANNABA', the Students' Union of Markaz Malik Deenar</strong>. This festival stands as the ultimate arena for our students, who pursue rigorous religious and academic higher studies, to unleash their versatile talents. With over 150 participants competing across disciplines like literature, arts, and public discourse, the campus transforms into a vibrant hub of talent. This eagerly anticipated event is designed to champion the holistic development and excellence of every student in the institution.
</p>
              <div class="hero-buttons" >
                <a href="#teams" class="btn-hero btn-primary">
                  <i class="bi bi-people"></i> Meet Teams
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Animated Background Elements -->
    <div class="floating-shapes">
      <div class="shape shape-1"></div>
      <div class="shape shape-2"></div>
      <div class="shape shape-3"></div>
    </div>
  </section>

  <!-- Teams Section with Historical Background -->
  <section id="teams" class="teams-section">
    <div class="container">
      <h2 class="section-title" data-aos="fade-down">
        <i class="bi bi-people-fill"></i> Our Legendary Teams
      </h2>
      <div class="row g-4">
        {{#each teams}}
        <div class="col-12 col-md-6 col-lg-3" data-aos="zoom-in" data-aos-delay="{{@index}}00">
          <div class="team-card-historical" data-team="{{this.teamName}}" style="{{#if this.teamColor}}border-top: 4px solid {{this.teamColor}}; {{/if}}">
            <div class="team-header">
              <div class="team-icon-wrapper" style="{{#if this.teamColor}}color: {{this.teamColor}};{{/if}}">
                <i class="bi bi-flag-fill"></i>
              </div>
              <h3 class="team-name-hist">{{this.teamName}}</h3>
            </div>
            <div class="team-body">
              <div class="historical-info">
                {{#if (eq this.teamName "GHARNATA")}}
                  <p class="history-text">The Pinnacle of Glory and last stronghold of Islamic Spain, famed for the Alhambra. It stands for dedication, excellence, and timeless beauty.</p>
                {{else if (eq this.teamName "SARAQUSTA")}}
                  <p class="history-text">A resilient center of intellect, advancing in philosophy and science despite challenges, symbolizing strength and intellectual courage.</p>
                {{else if (eq this.teamName "THULYTHULA")}}
                  <p class="history-text">Known as the Bridge of Knowledge, Tulaytula was a multicultural center where Muslim, Christian, and Jewish scholars translated great works, sparking Europe’s Renaissance. It stands for inclusion, dialogue, and shared wisdom.</p>
                {{else if (eq this.teamName "ISHBILIYYA")}}
                  <p class="history-text">The Cultural Capital of Al-Andalus, celebrated for its art, poetry, and architecture, especially under the Almohads. It represents creativity, beauty, and collective artistry.</p>
                {{else}}
                  <p class="history-text">A team dedicated to excellence, unity, and creative expression in the spirit of Zing Zephyr.</p>
                {{/if}}
              </div>
            </div>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </section>

</div>

<script>
  // Team card hover effects
  document.querySelectorAll('.team-card-historical').forEach(card => {
    card.addEventListener('mouseenter', function() {
      this.classList.add('hovered');
    });
    card.addEventListener('mouseleave', function() {
      this.classList.remove('hovered');
    });
  });

  // Smooth scrolling for anchor links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const target = document.querySelector(this.getAttribute('href'));
      if (target) {
        target.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    });
  });

  // Prevent back navigation - exit site instead
  (function() {
    // Replace current history entry to prevent back navigation
    window.history.pushState(null, null, window.location.href);
    
    // Listen for back button press
    window.addEventListener('popstate', function(event) {
      // Push state again to prevent navigation
      window.history.pushState(null, null, window.location.href);
      
      // Show confirmation and exit
      Swal.fire({
        title: 'Exit Site?',
        html: '<p>Are you sure you want to leave this page?</p>',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Yes, Exit',
        cancelButtonText: 'Stay',
        customClass: {
          popup: 'swal-custom-popup'
        }
      }).then((result) => {
        if (result.isConfirmed) {
          // Try to close the window/tab
          if (window.opener) {
            // If opened in a popup, close it
            window.close();
          } else {
            // For regular tabs, try to close (may not work due to browser security)
            // If close fails, redirect to blank page
            try {
              window.close();
              // If window.close() doesn't work, redirect after a short delay
              setTimeout(() => {
                if (!document.hidden) {
                  window.location.href = 'about:blank';
                }
              }, 100);
            } catch (e) {
              // Fallback: redirect to blank page
              window.location.href = 'about:blank';
            }
          }
        }
      });
    });

    // Also prevent back navigation on page load
    window.history.pushState(null, null, window.location.href);
  })();
</script>
