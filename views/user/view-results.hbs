{{!-- view-results.hbs - Display published results for users --}}
<link rel="stylesheet" href="/stylesheets/view-results.css">

<div class="results-container container py-4">
  <div class="row mb-4">
    <div class="col-12">
      <h2 class="section-title text-center mb-4">Program Results</h2>
      
      <!-- Search Bar -->
      <div class="search-container mb-4">
        <div class="input-group">
          <input type="text" id="resultSearch" class="form-control" placeholder="Search for programs...">
          <button class="btn btn-primary" type="button" id="searchButton">
            <i class="fas fa-search"></i> Search
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Results Display -->
  <div class="row" id="resultsContainer">
    {{#if publishedResults.length}}
      {{#each publishedResults}}
        <div class="col-md-6 col-lg-4 mb-4 program-result-card" data-program="{{this.programName}}">
          <div class="card h-100">
            <div class="card-header">
              <h5 class="card-title mb-0">#{{@index}} {{this.programName}}</h5>
              <p class="card-subtitle text-muted">{{this.zone}}</p>
            </div>
            <div class="card-body">
              <div class="winners-list">
                {{#if this.results.length}}
                  {{#with (lookup this.results 0)}}
                    <div class="winner first-prize">
                      <div class="prize-badge">First Prize</div>
                      <div class="winner-details">
                        <h6 class="winner-name">{{this.name}}</h6>
                        <p class="winner-team">{{this.team}}</p>
                      </div>
                    </div>
                  {{/with}}
                  
                  {{#with (lookup this.results 1)}}
                    <div class="winner second-prize">
                      <div class="prize-badge">Second Prize</div>
                      <div class="winner-details">
                        <h6 class="winner-name">{{this.name}}</h6>
                        <p class="winner-team">{{this.team}}</p>
                      </div>
                    </div>
                  {{/with}}
                  
                  {{#with (lookup this.results 2)}}
                    <div class="winner third-prize">
                      <div class="prize-badge">Third Prize</div>
                      <div class="winner-details">
                        <h6 class="winner-name">{{this.name}}</h6>
                        <p class="winner-team">{{this.team}}</p>
                      </div>
                    </div>
                  {{/with}}
                {{else}}
                  <p class="no-results">No results available</p>
                {{/if}}
              </div>
            </div>
          </div>
        </div>
      {{/each}}
    {{else}}
      <div class="col-12 text-center">
        <div class="alert alert-info">
          No published results available yet.
        </div>
      </div>
    {{/if}}
  </div>
</div>

<script>
  // Search functionality
  document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('resultSearch');
    const searchButton = document.getElementById('searchButton');
    const resultCards = document.querySelectorAll('.program-result-card');
    
    function performSearch() {
      const searchTerm = searchInput.value.toLowerCase().trim();
      
      resultCards.forEach(card => {
        const programName = card.getAttribute('data-program').toLowerCase();
        if (programName.includes(searchTerm) || searchTerm === '') {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    }
    
    searchButton.addEventListener('click', performSearch);
    searchInput.addEventListener('keyup', function(event) {
      if (event.key === 'Enter') {
        performSearch();
      }
    });
  });
</script>