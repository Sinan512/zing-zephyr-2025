<link rel="stylesheet" href="/stylesheets/team-status.css">

<div class="team-status-container">
  <div class="container py-4">
    <div class="row justify-content-center">
      <div class="col-12">
        <h2 class="page-title text-center mb-4">
          <i class="bi bi-star-fill"></i> Zone Toppers
        </h2>

        {{#if zoneToppers}}
          
          <!-- Pre Zone Topper -->
          {{#if zoneToppers.preZone}}
          <div class="zone-section mb-5">
            <h3 class="section-title text-center mb-4">
              <i class="bi bi-star-fill"></i> Pre Zone Topper
            </h3>
            <div class="teams-leaderboard row justify-content-center">
              <div class="col-12 col-md-6 col-lg-4">
                <div class="team-status-card rank-first">
                  <div class="rank-badge-large">🥇</div>
                  <div class="team-info-content text-center">
                    <h3 class="team-status-name">{{zoneToppers.preZone.member}}</h3>
                    <p class="topper-team-name">{{zoneToppers.preZone.team}}</p>
                    <div class="points-section">
                      <span class="points-label">Total Marks</span>
                      <span class="points-value-large">{{zoneToppers.preZone.points}}</span>
                    </div>
                    <div class="programs-section mt-2">
                      <span class="points-label">Programs</span>
                      <span class="points-value-large">{{zoneToppers.preZone.programCount}}</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          {{/if}}

          <!-- Mid Zone Topper -->
          {{#if zoneToppers.midZone}}
          <div class="zone-section mb-5">
            <h3 class="section-title text-center mb-4">
              <i class="bi bi-star-fill"></i> Mid Zone Topper
            </h3>
            <div class="teams-leaderboard row justify-content-center">
              <div class="col-12 col-md-6 col-lg-4">
                <div class="team-status-card rank-first">
                  <div class="rank-badge-large">🥇</div>
                  <div class="team-info-content text-center">
                    <h3 class="team-status-name">{{zoneToppers.midZone.member}}</h3>
                    <p class="topper-team-name">{{zoneToppers.midZone.team}}</p>
                    <div class="points-section">
                      <span class="points-label">Total Marks</span>
                      <span class="points-value-large">{{zoneToppers.midZone.points}}</span>
                    </div>
                    <div class="programs-section mt-2">
                      <span class="points-label">Programs</span>
                      <span class="points-value-large">{{zoneToppers.midZone.programCount}}</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          {{/if}}

          <!-- High Zone Topper -->
          {{#if zoneToppers.highZone}}
          <div class="zone-section mb-5">
            <h3 class="section-title text-center mb-4">
              <i class="bi bi-star-fill"></i> High Zone Topper
            </h3>
            <div class="teams-leaderboard row justify-content-center">
              <div class="col-12 col-md-6 col-lg-4">
                <div class="team-status-card rank-first">
                  <div class="rank-badge-large">🥇</div>
                  <div class="team-info-content text-center">
                    <h3 class="team-status-name">{{zoneToppers.highZone.member}}</h3>
                    <p class="topper-team-name">{{zoneToppers.highZone.team}}</p>
                    <div class="points-section">
                      <span class="points-label">Total Marks</span>
                      <span class="points-value-large">{{zoneToppers.highZone.points}}</span>
                    </div>
                    <div class="programs-section mt-2">
                      <span class="points-label">Programs</span>
                      <span class="points-value-large">{{zoneToppers.highZone.programCount}}</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          {{/if}}

        {{else}}
          <div class="empty-state text-center">
            <i class="bi bi-inbox"></i>
            <p>Zone toppers not published yet. Check back soon!</p>
          </div>
        {{/if}}
      </div>
    </div>
  </div>
</div>
