<link rel="stylesheet" href="/stylesheets/admin-home.css">

<section id="admin-panel" class="admin-section">
  <div class="container text-center">

    <!-- Heading -->
    <div class="fade-in-up">
      <h2 class="panel-title">Admin Control Panel</h2>
      <p class="panel-subtitle">Manage everything for {{fName}} effortlessly.</p>
    </div>

    <!-- Action Buttons -->
    <div class="action-buttons fade-in-up">
      <a href="/admin/edit-result" class="admin-btn settings">Valuation</a>
      <a href="/admin/call-list" class="admin-btn call">Call List</a>
      <a href="/admin/publish" class="admin-btn publish">Publish</a>
    </div>

    <!-- Team Highlight Section -->
    <div class="team-grid">
        {{#each teams}}
      <div class="team-card fade-in-up">
        <h3>{{this.teamName}}</h3>
        <a class="btn" href="/admin/add-members/{{this.teamName}}">Add/Edit Members</a>
      </div>
        {{/each}}
    </div>
  </div>
</section>

<script>
  // Fade in when in view
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) entry.target.classList.add('in-view');
    });
  });

  document.querySelectorAll('.fade-in-up').forEach(el => observer.observe(el));
</script>
