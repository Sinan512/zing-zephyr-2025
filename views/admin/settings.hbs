<link rel="stylesheet" href="/stylesheets/admin-settings.css" />

<section class="fest-section container py-5">

  <!-- FEST TITLE SECTION -->
  <div class="text-center mb-4 fade-in-up">
    <h1
      class="fest-title text-decoration-none"
      id="festTitle"
      contenteditable="true"
    >{{fName}}</h1>
    <p class="fest-subtitle">Click the title to edit the Fest name</p>
  </div>

  <div class="row justify-content-center g-4">

    <!-- TEAMS SECTION (TOP) -->
    <div class="col-12 col-md-10 col-lg-8 fade-in-up">
      <div class="section-card">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h3 class="section-title">Teams</h3>
        </div>

        <!-- Add Team Input -->
        <form
          action="/admin/add-team"
          method="POST"
          class="d-flex mb-3 add-team-box"
        >
          <input
            type="text"
            name="teamName"
            class="form-control"
            placeholder="Enter new team name..."
            required
          />
          <input
            type="color"
            name="teamColor"
            class="form-control form-control-color"
            value="#3498db"
            title="Choose team color"
            style="width: 60px; height: 38px; cursor: pointer;"
          />
          <button type="submit" class="btn add-team-btn">Add</button>
        </form>

        <div class="list-group">
          {{#each teams}}
            <div class="list-item fade-item d-flex justify-content-between align-items-center">
              <span>{{this.teamName}}</span>
              <form action="/admin/remove-team" method="POST" onclick="return confirm('Do You Want To Remove This Team?')">
                <input type="hidden" name="teamName" value="{{this.teamName}}" />
                <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash-fill"></i></button>
              </form>
            </div>
          {{/each}}
        </div>
      </div>
    </div>

    <!-- Add Program Form -->
    <form
      action="/admin/add-program"
      method="POST"
      class="col-12 col-md-10 col-lg-8 fade-in-up add-program-card"
    >

      <h3 class="form-title">Add New Program</h3>

      <div class="input-group">
        <label>Program Name</label>
        <input
          type="text"
          name="programName"
          placeholder="Enter program name..."
          required
        />
      </div>

      <div class="input-group">
        <label>Zone</label>
        <select name="zone" required>
          <option value="" disabled selected>Select Zone</option>
          <option value="Pre Zone">Pre Zone</option>
          <option value="Mid Zone">Mid Zone</option>
          <option value="High Zone">High Zone</option>
          <option value="General">General</option>
        </select>
      </div>

      <div class="input-group">
        <label>Maximum Mark</label>
        <select name="maxMark" required>
          <option value="" disabled selected>Select Maximum Mark</option>
          <option value="11">11</option>
          <option value="15">15</option>
          <option value="20">20</option>
          <option value="25">25</option>
        </select>
      </div>

      <div class="input-group">
        <label>Stage / Non-Stage</label>
        <select name="stageType" required>
          <option value="" disabled selected>Select Type</option>
          <option value="Stage">Stage</option>
          <option value="Non Stage">Non Stage</option>
        </select>
      </div>

      <div class="input-group">
        <label>Program Type</label>
        <select name="programType" required>
          <option value="" disabled selected>Select Program Type</option>
          <option value="Individual">Individual</option>
          <option value="Group">Group</option>
        </select>
      </div>

      <button type="submit" class="add-btn" onclick="return alert('PRGRAM ADDED SUCCESSFULLY')">Add Program</button>
    </form>
    <div class="col-12 col-md-10 col-lg-8 fade-in-up">
      <div class="section-card">
        {{#if programs}}
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h3 class="section-title">Programs</h3>
        </div>
        {{/if}}
        <div class="list-group">
          {{#each programs}}
            <div class="list-item fade-item d-flex justify-content-between align-items-center text-uppercase">
              <span>{{this.programName}}</span>
              <form action="/admin/remove-program" method="POST" onclick="return confirm('Do You Want To Remove This Progam?')">
                <input type="hidden" name="programName" value="{{this.programName}}" />
                <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash-fill"></i></button>
              </form>
            </div>
          {{/each}}
        </div>
      </div>
    </div>

    <!-- ADMIN CREDENTIALS SECTION -->
    <div class="col-12 col-md-10 col-lg-8 fade-in-up">
      <div class="section-card">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h3 class="section-title">Admin Credentials</h3>
        </div>
        
        <form action="/admin/reset-credentials" method="POST" class="admin-credentials-form">
          <div class="input-group mb-3">
            <label for="newUsername">New Username</label>
            <input
              type="text"
              id="newUsername"
              name="username"
              placeholder="Enter new username..."
              required
              class="form-control"
            />
          </div>
          
          <div class="input-group mb-3">
            <label for="newPassword">New Password</label>
            <input
              type="password"
              id="newPassword"
              name="password"
              placeholder="Enter new password..."
              required
              class="form-control"
            />
          </div>
          
          <button type="submit" class="btn-reset-credentials">
            <i class="bi bi-key-fill text-dark"></i> Reset Credentials
          </button>
        </form>
      </div>
    </div>

    <!-- ADD-POINT CREDENTIALS SECTION -->
    <div class="col-12 col-md-10 col-lg-8 fade-in-up">
      <div class="section-card">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h3 class="section-title">Add-Point Credentials</h3>
        </div>
        <form action="/admin/reset-addpoint-credentials" method="POST" class="admin-credentials-form">
          <div class="input-group mb-3">
            <label for="apUsername">Username</label>
            <input
              type="text"
              id="apUsername"
              name="username"
              placeholder="pointer"
              required
              class="form-control"
              value="pointer"
            />
          </div>
          <div class="input-group mb-3">
            <label for="apPassword">Password</label>
            <input
              type="text"
              id="apPassword"
              name="password"
              placeholder="point@123"
              required
              class="form-control"
              value="point@123"
            />
          </div>
          <button type="submit" class="btn-reset-credentials">
            <i class="bi bi-key-fill text-dark"></i> Reset Add-Point Credentials
          </button>
        </form>
      </div>
    </div>

    
    <!-- ADD-CODE-LETTER CREDENTIALS SECTION -->
    <div class="col-12 col-md-10 col-lg-8 fade-in-up">
      <div class="section-card">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h3 class="section-title">Add-Code Letter Credentials</h3>
        </div>
        <form action="/admin/reset-addcodeletter-credentials" method="POST" class="admin-credentials-form">
          <div class="input-group mb-3">
            <label for="apUsername">Username</label>
            <input
              type="text"
              id="apUsername"
              name="username"
              placeholder="code letter user name"
              required
              class="form-control"
            />
          </div>
          <div class="input-group mb-3">
            <label for="apPassword">Password</label>
            <input
              type="text"
              id="apPassword"
              name="password"
              placeholder="password"
              required
              class="form-control"
            />
          </div>
          <button type="submit" class="btn-reset-credentials">
            <i class="bi bi-key-fill text-dark"></i> Reset Add-Code-Letter Credentials
          </button>
        </form>
      </div>
    </div>

  </div>

</section>

<script>
  // Enter key update fest name const festTitle =
  document.getElementById("festTitle"); festTitle.addEventListener("keydown",
  (e) => { if (e.key === "Enter") { e.preventDefault(); const newTitle =
  festTitle.innerText.trim(); fetch("/admin/update-fest-name", { method: "POST",
  headers: { "Content-Type": "application/x-www-form-urlencoded" }, body:
  `festName=${encodeURIComponent(newTitle)}` }).catch(err =>
  console.error("Error sending data:", err)); } }); // Fade-in animation const
  observer = new IntersectionObserver(entries => { entries.forEach(entry => { if
  (entry.isIntersecting) entry.target.classList.add("in-view"); }); });
  document.querySelectorAll(".fade-in-up, .fade-item").forEach(el =>
  observer.observe(el));
</script>