<link rel="stylesheet" href="/stylesheets/code-letter-add.css">

<!-- HTML (Handlebars-aware) -->
<div class="container-fluid py-5 px-3 premium-page">

  <!-- Page Title -->
  <div class="text-center mb-4">
    <h2 class="fw-bold text-light display-6 fade-slide"> Assign Code Letters to Participants</h2>
    <p class="text-dark opacity-50 lead fade-slide">Search by program and add unique code letters to each participant.</p>
  </div>

  <!-- 🔍 Program Search -->
  <div class="text-center mb-5 fade-slide">
    <div class="search-wrap mx-auto w-100 w-md-75">
      <label for="programSearch" class="visually-hidden">Search Program</label>
      <input type="text" id="programSearch" class="form-control shadow search-input" placeholder="🔎 Search Program...">
      <div class="search-hint">Type to filter programs</div>
    </div>
  </div>

  <!-- Table Section -->
  <div class="row justify-content-center" id="programContainer">
    {{#each groupedCallList}}
    <div class="col-12 col-md-10 col-lg-8 program-block mb-5 fade-up">
      <div class="card border-0 shadow-lg bg-gradient-custom rounded-4 p-0 overflow-hidden program-card">
        <!-- header with program title + control buttons -->
        <div class="program-card-header d-flex align-items-center justify-content-between px-4 py-3">
          <h4 class="fw-bold text-warning mb-0 program-title text-uppercase">{{@key}}</h4>
          {{#if (lookup ../codeletterAdded @key)}}
            <h4 class="fw-bold text-success fst-italic mb-0 program-title">ALREADY ADDED</h4>
          {{/if}}
          <div class="header-controls">
            <a class="btn btn-sm submit-head-btn" data-program="{{@key}}">Submit Codes</a>
          </div>
        </div>

        <!-- table area with subtle background -->
        <div class="program-card-body p-3">
          <div class="table-responsive">
            <table id="codeLetterTable-{{@key}}" data-program="{{@key}}" class="table table-hover table-custom mb-0 align-middle">
              <thead class="table-head">
                <tr>
                  <th class="participant-col">Participant</th>
                  <th class="team-col">Team</th>
                  <th class="code-col">Code Letter</th>
                </tr>
              </thead>
              <tbody>
                {{#each this}}
                <tr class="table-row">
                  <td class="text-truncate participant-cell text-uppercase" title="{{member}}">{{member}}</td>
                  <td><span class="w-220px px-3 py-2">{{team}}</span></td>
                  <td>
                    <input 
                      type="text" 
                      class="form-control form-control-sm code-input text-uppercase" 
                      placeholder="Enter Code"
                      data-member="{{member}}" 
                      data-program="{{@../key}}" 
                      data-team="{{team}}" 
                      maxlength="4"
                      value="{{codes}}">
                    <small class="duplicate-warning">Duplicate Code!</small>
                  </td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </div>
    {{/each}}
  </div>
</div>

<script>
$(document).ready(function() {
  // Initialize DataTables for each table id (destroy-if-exists safe)
  $('table[data-program]').each(function() {
    if ($.fn.dataTable.isDataTable(this)) {
      $(this).DataTable().destroy();
    }
    $(this).DataTable({
      searching: false,
      paging: false,
      info: false,
      ordering: false,
      autoWidth: false,
      columnDefs: [{ targets: [2], width: 160 }]
    });
  });

  // 🔍 Global program search (frosted glass input)
  $('#programSearch').on('input', function() {
    const query = $(this).val().toLowerCase().trim();
    $('.program-block').each(function() {
      const programName = $(this).find('.program-title').text().toLowerCase();
      // Also check participants and teams for small convenience
      const rowsText = $(this).find('tbody').text().toLowerCase();
      const matched = programName.includes(query) || rowsText.includes(query);
      $(this).toggle(matched);
    });
  });

   // --- ✅ Real-time Duplicate Validation ---
  $(document).on('input', '.code-input', function() {
    const $input = $(this);
    const code = $input.val().trim().toUpperCase();
    const $table = $input.closest('table');
    const program = $table.data('program');

    // Normalize value in field
    $input.val(code);

    // Remove old styles
    $input.removeClass('duplicate');
    $input.siblings('.duplicate-warning').hide();

    if (!code) return; // skip if empty

    // Check all other inputs in same program
    const codes = [];
    $table.find('.code-input').each(function() {
      const val = $(this).val().trim().toUpperCase();
      if (val) codes.push(val);
    });

    const duplicates = codes.filter((v, i, a) => a.indexOf(v) !== i);
    const isDuplicate = duplicates.includes(code);

    if (isDuplicate) {
      // Mark all duplicates visually
      $table.find('.code-input').each(function() {
        if ($(this).val().trim().toUpperCase() === code) {
          $(this).addClass('duplicate');
          $(this).siblings('.duplicate-warning').fadeIn(150);
        }
      });
    } else {
      $input.removeClass('duplicate');
      $input.siblings('.duplicate-warning').fadeOut(150);
    }
  });
  // Submit codes from header button
  $('.submit-head-btn').on('click', function() {
    const program = $(this).data('program');
    const codes = [];

    const $table = $(`table[data-program="${program}"]`);
    $table.find('.code-input').each(function() {
      const member = $(this).data('member');
      const team = $(this).data('team');
      const code = $(this).val().trim().toUpperCase();
      if (code) codes.push({ member, team, code });
    });

    if (codes.length === 0) {
      Swal.fire("⚠️ No codes", "No code letters entered for this program.", "warning");
      return;
    }

    // Show confirmation before sending
    Swal.fire({
      title: "Submit code letters?",
      text: `You're submitting ${codes.length} code(s) for "${program}".`,
      icon: "question",
      showCancelButton: true,
      confirmButtonText: "Yes, submit",
      cancelButtonText: "Cancel",
      focusCancel: true
    }).then(result => {
      if (!result.isConfirmed) return;
      // POST to server
      $.post("/admin/add-code-letter", { program, codes }, function(res) {
        if (res && res.success) {
          Swal.fire({
            title: "✅ Success!",
            text: res.message || "Code letter added successfully",
            icon: "success",
            timer: 2000,
            showConfirmButton: false
          }).then(() => {
            location.reload();
          });
        } else {
          Swal.fire("❌ Error!", (res && res.message) || "Server error. Try again.", "error");
        }
      }).fail(function() {
        Swal.fire("❌ Error!", "Request failed. Check your connection.", "error");
      });
    });
  });

  // Accessibility: allow Enter in code-input to move to next input
  $(document).on('keydown', '.code-input', function(e) {
    if (e.key === 'Enter') {
      e.preventDefault();
      const $inputs = $(this).closest('tbody').find('.code-input');
      const idx = $inputs.index(this);
      const next = $inputs.eq(idx + 1);
      if (next.length) next.focus();
      else $(this).blur();
    }
  });
});
</script>
