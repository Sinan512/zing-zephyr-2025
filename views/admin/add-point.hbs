<link rel="stylesheet" href="/stylesheets/add-point.css" />

<div class="container py-5">
  <div class="header-box">
    <h1 class="text-glow">Add Points</h1>
    <h5 class="text-light mt-2">{{programName}} — {{zone}}</h5>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
      {{#if admin}}
      <form action="/admin/save-points-admin" method="POST">
      {{else}}
      <form action="/admin/save-points" method="POST">
      {{/if}}
        <input type="hidden" name="programName" value="{{programName}}" />
        <input type="hidden" name="zone" value="{{zone}}" />

        <div class="card-custom">
          <ul class="code-list">
            <li class="code-item flex-row">
              <span
                class="text-uppercase float-start"
                for="codeLetter"
              >codeLetter</span>
              <span
                class="text-uppercase input-code mx-4"
                for="points"
              >Point</span>
            </li>
            {{#each codeLetters}}
              <li class="code-item">
                <span class="fw-semibold">{{this.codes}}</span>
                <input
                  type="number"
                  name="points[{{this.codes}}]"
                  class="input-point"
                  placeholder="0"
                  min="0"
                />
              </li>
            {{/each}}
          </ul>
        </div>
        <button type="submit" class="btn-submit" onclick="return confirm('SUBMIT POINTS ?')" >Submit Points</button>
        <!-- Success Message -->
        <div id="successMessage" class="success-message">
          <i class="fa-solid fa-check-circle"></i>
          Points Added Successfully!
        </div>
      </form>
    </div>
  </div>
</div>

<script>
document.querySelector(".btn-submit").addEventListener("click", function (e) {
  e.preventDefault(); // stop default just to show message before submit

  const msg = document.getElementById("successMessage");
  const form = this.closest("form");

  // Show success animation
  msg.style.display = "block";
  msg.style.animation = "glowIn 0.6s ease";

  // Wait briefly for animation, then submit form to router
  setTimeout(() => {
    form.submit(); // ✅ actually sends the form data to Express route
  }, 800); // slight delay for visual feedback
});
</script>

