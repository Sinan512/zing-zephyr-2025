<link rel="stylesheet" href="/stylesheets/select-program.css" />

<div class="container py-5">
    <div class="text-center mb-4">
      <h1 class="display-5 fw-bold text-white text-glow">Result Panel</h1>
      <p class="text-light">Find and manage program points easily</p>
    </div>

    <div class="row justify-content-center mb-3">
      <div class="col-lg-6 col-md-8">
        <input type="text" id="programSearch" class="search-box" placeholder="🔍 Search program...">
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-10 col-md-12">
        <div class="card-custom table-responsive">
          <table id="programTable" class="table table-borderless align-middle mb-0 w-100">
            <thead>
              <tr>
                <th class="text-start ps-4">Program Name</th>
                <th class="text-start ps-4">Zone</th>
                <th class="text-center">Action</th>
              </tr>
            </thead>
            <tbody>
              {{#each programs}}
              <tr class="program-row">
                <td class="ps-4">{{this.programName}}</td>
                <td class="ps-4">{{this.zone}}</td>
                <td class="text-center">
                  <a href="/admin/add-point?programName={{this.programName}}&zone={{this.zone}}" class="btn btn-add" data-program="{{this.programName}}" data-zone="{{this.zone}}">Add Point</a>
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script>
    $(document).ready(function() {
      // Initialize DataTable
      var table = $('#programTable').DataTable({
        paging: true,
        searching: true,
        info: true,
        ordering: true,
        pageLength: 8,
        lengthChange: false,
        language: { search: "" },
        columnDefs: [{ orderable: false, targets: 2 }]
      });

      // Custom search input filters DataTable
      $('#programSearch').on('keyup', function() {
        table.search(this.value).draw();
      });
      // Auto-copy Add Point login link (with redirect) on click, DO NOT navigate
      $(document).on('click', 'a.btn-add', async function(e) {
        e.preventDefault();
        const href = $(this).attr('href');
        const loginUrl = location.origin + '/admin/add-point-login?redirect=' + encodeURIComponent(href);
        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(loginUrl);
            showToast('Point adding link copied to clipboard', 'success');
          } else {
            showToast('Failed to copy link', 'error');
          }
        } catch(err) {
          showToast('Failed to copy link', 'error');
        }
        // Do not navigate; user will paste the link into another browser
      });

      function showToast(message, type) {
        const toast = $(`
          <div class="toast-notification toast-${type}" style="position: fixed; top: 20px; right: 20px; z-index: 9999; padding: 15px 20px; background: ${type === 'success' ? '#28a745' : '#dc3545'}; color: white; border-radius: 5px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); animation: slideIn 0.3s ease;">
            ${message}
          </div>
        `);
        $('body').append(toast);
        setTimeout(() => {
          toast.fadeOut(300, () => toast.remove());
        }, 3000);
      }
    });
  </script>