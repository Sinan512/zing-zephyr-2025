<link rel="stylesheet" href="/stylesheets/admin-header.css">

<header class="admin-header">
  <div class="header-inner container-fluid d-flex align-items-center justify-content-between">

    <!-- Left Logo -->
    <div class="d-flex align-items-center">
      <img src="/images/logo.jpg" alt="Left Logo" class="header-logo">
      <div class="fest-text ms-3">
        <h3 class="fest-name">{{fName}}</h3>
        <p class="fest-tagline">ANNABA' STUDENTS UNION — MARKAZ MALIK DINAR PARAPPALLI</p>
      </div>
    </div>

    <!-- Navigation Buttons -->
    <nav class="header-nav">
      <a href="/admin/enter" class="nav-btn">Home</a>
      {{#if codeLetter}}
      <a href="/admin/code-letter-add" class="nav-btn ">Add Code Letter</a>
      {{else}}
      <a href="/admin/view-result" class="nav-btn ">Result</a>
      {{/if}}
      <a href="/admin/settings" class="nav-btn ">Settings</a>
    </nav>

  </div>

  <!-- Marquee Line -->
