    </div>
  </div>

  <!-- Marquee Line -->
  <div class="header-marquee">
    <div class="scroll-track">
      <span>Zing Zephyr 2025 • ANNABA' STUDENTS UNION • “Burn the I, Build the We” •</span>
      <span>Zing Zephyr 2025 • ANNABA' STUDENTS UNION • “Burn the I, Build the We” •</span>
      <span>Zing Zephyr 2025 • ANNABA' STUDENTS UNION • “Burn the I, Build the We” •</span>
      <span>Zing Zephyr 2025 • ANNABA' STUDENTS UNION • “Burn the I, Build the We” •</span>
      <span>Zing Zephyr 2025 • ANNABA' STUDENTS UNION • “Burn the I, Build the We” •</span>
      <span>Zing Zephyr 2025 • ANNABA' STUDENTS UNION • “Burn the I, Build the We” •</span>
    </div>
  </div>
</header>

<script>
    $(document).ready(function() {
   // Auto-copy Add Point login link (with redirect) on click, DO NOT navigate
      $(document).on('click', 'a.btn-copy', async function(e) {
        e.preventDefault();
        const href = $(this).attr('href');
        const loginUrl = location.origin + '/admin/add-code-letter-login?redirect=' + encodeURIComponent(href);
        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(loginUrl);
            showToast('code letter adding link copied to clipboard', 'success');
          } else {
            showToast('Failed to copy link', 'error');
          }
        } catch(err) {
          showToast('Failed to copy link', 'error');
        }
        // Do not navigate; user will paste the link into another browser
      });
      //toast
      function showToast(message, type) {
        const toast = $(`
          <div class="toast-notification toast-${type}" style="position: fixed; top: 20px; right: 20px; z-index: 9999; padding: 15px 20px; background: ${type === 'success' ? '#28a745' : '#dc3545'}; color: white; border-radius: 5px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); animation: slideIn 0.3s ease;">
            ${message}
          </div>
        `);
        $('body').append(toast);
        setTimeout(() => {
          toast.fadeOut(300, () => toast.remove());
        }, 3000);
      }

    });
  // Mobile menu toggle
  document.addEventListener('DOMContentLoaded', function() {
    const toggle = document.getElementById('mobileMenuToggle');
    const dropdown = document.getElementById('mobileNavDropdown');
    
    if (toggle && dropdown) {
      toggle.addEventListener('click', function(e) {
        e.stopPropagation();
        const isActive = toggle.classList.toggle('active');
        dropdown.classList.toggle('active', isActive);
        toggle.setAttribute('aria-expanded', isActive);
      });
      
      // Close menu when clicking outside
      document.addEventListener('click', function(e) {
        if (!dropdown.contains(e.target) && !toggle.contains(e.target)) {
          toggle.classList.remove('active');
          dropdown.classList.remove('active');
          toggle.setAttribute('aria-expanded', 'false');
        }
      });

      // Close menu when clicking a nav item
      dropdown.querySelectorAll('.mobile-nav-item').forEach(item => {
        item.addEventListener('click', function() {
          toggle.classList.remove('active');
          dropdown.classList.remove('active');
          toggle.setAttribute('aria-expanded', 'false');
        });
      });
    }

    // Site Visibility Toggle
    const siteToggle = document.getElementById('siteVisibilityToggle');
    if (siteToggle) {
      siteToggle.addEventListener('change', function() {
        const isVisible = this.checked;
        $.ajax({
          url: '/admin/toggle-site-visibility',
          method: 'POST',
          data: { visible: isVisible },
          success: function(response) {
            if (response.success) {
              showToast(isVisible ? 'Site is now visible to users' : 'Site is now hidden from users', 'success');
            } else {
              showToast('Failed to update site visibility', 'error');
              // Revert toggle
              siteToggle.checked = !isVisible;
            }
          },
          error: function() {
            showToast('Failed to update site visibility', 'error');
            // Revert toggle
            siteToggle.checked = !isVisible;
          }
        });
      });
    }
  });
</script>
