<link rel="stylesheet" href="/stylesheets/admin-header.css">

<header class="admin-header">
  <div class="header-inner container-fluid d-flex align-items-center justify-content-between">

    <!-- Left Logo -->
    <div class="d-flex align-items-center flex-grow-1" style="min-width: 0;">
      <img src="/images/logo.jpg" alt="Logo" class="header-logo">
      <div class="fest-text ms-2 ms-md-3 flex-grow-1" style="min-width: 0;">
        <h3 class="fest-name">{{fName}}</h3>
        <p class="fest-tagline d-none d-md-block">ANNABA' STUDENTS UNION — MARKAZ MALIK DINAR PARAPPALLI</p>
      </div>
    </div>

    <!-- Navigation Buttons -->
    {{#unless hideAdminNav}}
    <nav class="header-nav flex-shrink-0">
      <a href="/admin/enter" class="nav-btn">Home</a>
      {{#if codeLetter}}
      <a href="/admin/code-letter-add" class="nav-btn">Code Letter</a>
      {{else}}
      <a href="/admin/view-result" class="nav-btn">Result</a>
      {{/if}}
      <a href="/admin/settings" class="nav-btn">Settings</a>
      <a href="/admin/logout" class="nav-btn">Logout</a>
    </nav>
    {{/unless}}

  </div>

  <!-- Marquee Line -->
  <div class="header-marquee">
    <div class="scroll-track">
      <span>Zing Zephyr 2025 • ANNABA' STUDENTS UNION • “Burn the I, Build the We” •</span>
      <span>Zing Zephyr 2025 • ANNABA' STUDENTS UNION • “Burn the I, Build the We” •</span>
      <span>Zing Zephyr 2025 • ANNABA' STUDENTS UNION • “Burn the I, Build the We” •</span>
      <span>Zing Zephyr 2025 • ANNABA' STUDENTS UNION • “Burn the I, Build the We” •</span>
      <span>Zing Zephyr 2025 • ANNABA' STUDENTS UNION • “Burn the I, Build the We” •</span>
      <span>Zing Zephyr 2025 • ANNABA' STUDENTS UNION • “Burn the I, Build the We” •</span>
    </div>
  </div>
</header>
