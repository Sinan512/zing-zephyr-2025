      <img src="/images/logo.png" alt="Logo" class="header-logo">
      <div class="fest-text ms-2 ms-md-3 flex-grow-1" style="min-width: 0;">
        <h3 class="fest-name">{{fName}}</h3>
        <p class="fest-tagline d-none d-md-block">ANNABA' STUDENTS UNION — MARKAZ MALIK DINAR PARAPPALLI</p>
      </div>
    </div>

    <!-- Mobile Menu Toggle (Right Side) -->
<button class="mobile-menu-toggle d-md-none" id="mobileMenuToggle" type="button" aria-label="Toggle menu" aria-expanded="false">
  <span class="hamburger-line"></span>
  <span class="hamburger-line"></span>
  <span class="hamburger-line"></span>
</button>
    <!-- Mobile Dropdown Menu -->
    <div class="mobile-nav-dropdown d-md-none" id="mobileNavDropdown">
     <!-- Navigation Buttons -->
    {{#unless hideAdminNav}}
      <a href="/admin/enter" class="nav-btn mobile-nav-item">Home</a>
      {{#if codeLetter}}
      <a href="/admin/code-letter-add" class="nav-btn mobile-nav-item">Code Letter</a>
