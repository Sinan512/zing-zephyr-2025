<link rel="stylesheet" href="/stylesheets/header.css">

<!-- Hero Section -->
<section class="hero-section position-relative overflow-hidden">

  <!-- Parallax Background Layers -->
  <div class="bg-layer layer1"></div>
  <div class="bg-layer layer2"></div>
  <div class="bg-layer layer3"></div>

  <!-- Top Logos -->
  <div class="position-absolute top-0 start-0 p-3">
    <img src="logo-left.png" alt="Left Logo" class="hero-logo img-fluid">
  </div>
  <div class="position-absolute top-0 end-0 p-3">
    <img src="logo-right.png" alt="Right Logo" class="hero-logo img-fluid">
  </div>

  <!-- Centered Top Buttons -->
  <div class="hero-buttons d-flex justify-content-center position-absolute top-0 start-50 translate-middle-x mt-3 z-10">
    <a href="#results" class="btn btn-danger btn-custom mx-2">Edit Results</a>
    <a href="#teams" class="btn btn-dark mx-2">Team Status</a>
    <a href="#schedule" class="btn btn-success mx-2">Edit Schedule</a>
  </div>

  <!-- Hero Content -->
  <div class="hero-content container text-center text-dark">
    <h1 class="display-4 fw-bold animate__animated animate__fadeInDown">Zing Zephyr 2025</h1>
    <p class="lead opacity-75 animate__animated animate__fadeInUp">ANNABA' STUDENTS UNION</p>
    <p class="lead opacity-50 animate__animated animate__fadeInUp">MARKAZ MALIK DINAR PARAPPALLI</p>
    <p class="lead animate__animated animate__fadeInUp">“Burn the I, Build the We”</p>
  </div>

  <!-- Moving Text Marquee -->
  <div class="moving-text">
    <div class="marquee-track">
      <span>Zing Zephyr 2025 | ANNABA' students union</span>
      <span>Zing Zephyr 2025 | ANNABA' students union</span>
      <span>Zing Zephyr 2025 | ANNABA' students union</span>
      <span>Zing Zephyr 2025 | ANNABA' students union</span>
      <span>Zing Zephyr 2025 | ANNABA' students union</span>
      <span>Zing Zephyr 2025 | ANNABA' students union</span>
    </div>
  </div>

</section>
